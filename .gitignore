node_modules/
dist/
coverage/
.DS_Store

.env
.env.*
!.env.example

# The Cloudflare tunnel token, mounted as a Docker secret. It is an unbranded
# base64 blob, so GitHub's push protection will not recognise it on the way out
# — this entry is the only thing standing between it and the remote.
secrets/

# Scratch copy of the Claude Design export the UI was ported from. Kept out of
# git: the design project is the source of truth, this tree is the port.
.design/

.idea/
.vscode/

# --- tennisproc (the Python ETL that produces the clips this app reviews) ---

__pycache__/
*.pyc
.venv/
.venv313/

# ETL output: clips, frames, pose and metadata per swing, plus stage caches
# under work/. Regenerable from the source video, and large (~2-6 MB per
# swing).
#
# user-edit.json is the exception and IS tracked: it is human review work, the
# only thing in this tree that no amount of recomputation brings back. A plain
# `!out/*/swings/*/user-edit.json` would not work -- git does not descend into
# an excluded directory, so every level has to stay traversable while its
# contents are excluded. That is what the ladder below does.
out/*
!out/*/
out/*/*
!out/*/swings/
out/*/swings/*
!out/*/swings/*/
out/*/swings/*/*
!out/*/swings/*/user-edit.json

# Source video: the sessions this pipeline reads. 15 iPhone .MOV files,
# 13.3 GB total, 683 MB median, 3.8 GiB largest (IMG_0479). Thirteen of the
# fifteen are over GitHub's 100 MB per-file limit, so a stray `git add .` here
# does not fail politely -- it makes a commit that cannot be pushed and has to
# be rewritten out of history.
#
# scripts/process.sh reads raw/<stem>.MOV, and tests/test_real_footage.py
# falls back to it when the fixture's recorded path no longer exists.
raw/

# MediaPipe pose models (~14 MB). Download link is in tennisproc/README.md.
models/

# Scratch trees the dev-middleware tests build in the repo root
# (.test-tmp, .test-tmp-sessions, .test-tmp-write, ... in
# vite-plugin-shot-lab.test.ts). Removed on teardown, left behind when a run
# is interrupted.
.test-tmp*
