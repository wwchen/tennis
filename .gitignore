node_modules/
dist/
coverage/
.DS_Store

.env
.env.*
!.env.example

# The Cloudflare tunnel token, mounted as a Docker secret. It is an unbranded
# base64 blob, so GitHub's push protection will not recognise it on the way out
# — this entry is the only thing standing between it and the remote.
secrets/

# Scratch copy of the Claude Design export the UI was ported from. Kept out of
# git: the design project is the source of truth, this tree is the port.
.design/

.idea/
.vscode/

# --- tennisproc (the Python ETL that produces the clips this app reviews) ---

__pycache__/
*.pyc
.venv/
.venv313/

# ETL output: clips, frames, pose and metadata per swing, plus stage caches
# under work/. Regenerable from the source video, and large (~2-6 MB per
# swing).
#
# Note that user-edit.json — human review work, which is NOT regenerable —
# also lands in here. If you start reviewing swings, either track those files
# deliberately or back them up outside this tree.
out/

# MediaPipe pose models (~14 MB). Download link is in tennisproc/README.md.
models/
